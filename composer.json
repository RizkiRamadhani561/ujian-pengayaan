{
  "name": "rizkir/klinik-sehat-ci4",
  "description": "Sistem Informasi Klinik Sehat with CodeIgniter 4 and MySQL/MariaDB",
  "type": "project",
  "license": "MIT",
  "require": {"php": "^8.1", "codeigniter4/framework": "^4.7"},
  "autoload": {"psr-4": {"App\\": "app/", "Config\\": "app/Config/"}},
  "scripts": {"serve": "php spark serve", "test:syntax": "php tests/syntax-check.php"},
  "config": {"optimize-autoloader": true, "sort-packages": true},
  "prefer-stable": true,
  "minimum-stability": "stable"
}
